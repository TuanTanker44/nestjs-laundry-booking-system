# Sao chep thanh .env.test (da nam trong .gitignore) de Vitest nap vao process.env.
# Chi dat gia tri danh cho test. Khong dung secret/DB cua moi truong that.
# Thieu bien nao trong file nay thi test khong nhan bien do (khong doc .env).

NODE_ENV=test
PORT=3001
CORS_ORIGIN=http://localhost:5173

# DB rieng cho test (e2e/integration). Khong tro vao DB dev.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=laundry_booking_test
DB_PORT=5432
DATABASE_URL=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_KEY_SECRET=test-redis-key-secret

SALT_ROUNDS=4
JWT_ACCESS_SECRET=test-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret
PASSWORD_RESET_TOKEN_SECRET=test-reset-secret
EMAIL_VERIFICATION_TOKEN_SECRET=test-verify-secret

# Tat rate limit de test dang ky/dang nhap khong bi 429
RATE_LIMIT_ENABLED=false
