generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model addresses {
  id                                               Int                 @id @default(autoincrement())
  user_id                                          Int
  label                                            String              @default("Nhà riêng") @db.VarChar(50)
  recipient_name                                   String              @db.VarChar(100)
  phone                                            String              @db.VarChar(20)
  address_line                                     String              @db.VarChar(255)
  ward                                             String?             @db.VarChar(100)
  district                                         String?             @db.VarChar(100)
  city                                             String?             @db.VarChar(100)
  latitude                                         Decimal?            @db.Decimal(10, 7)
  longitude                                        Decimal?            @db.Decimal(10, 7)
  is_default                                       Boolean             @default(false)
  created_at                                       DateTime            @default(now()) @db.Timestamp(6)
  updated_at                                       DateTime            @default(now()) @db.Timestamp(6)
  users                                            users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_addresses_user")
  bookings_bookings_delivery_address_idToaddresses bookings[]          @relation("bookings_delivery_address_idToaddresses")
  bookings_bookings_pickup_address_idToaddresses   bookings[]          @relation("bookings_pickup_address_idToaddresses")
  customer_profiles                                customer_profiles[]
  delivery_trips                                   delivery_trips[]

  @@index([user_id], map: "idx_addresses_user")
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  actor_id    Int?
  action      String   @db.VarChar(50)
  entity_type String   @db.VarChar(50)
  entity_id   Int
  old_value   Json?
  new_value   Json?
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users?   @relation(fields: [actor_id], references: [id], onUpdate: NoAction, map: "fk_audit_logs_actor")

  @@index([actor_id], map: "idx_audit_logs_actor")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
}

model booking_items {
  id         Int          @id @default(autoincrement())
  booking_id Int
  item_name  String       @db.VarChar(100)
  category   String?      @db.VarChar(50)
  quantity   Int          @default(1)
  unit_price Decimal?     @db.Decimal(10, 2)
  note       String?      @db.VarChar(255)
  created_at DateTime     @default(now()) @db.Timestamp(6)
  bookings   bookings     @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_items_booking")
  complaints complaints[]

  @@index([booking_id], map: "idx_booking_items_booking")
}

model bookings {
  id                                                Int                  @id @default(autoincrement())
  booking_code                                      String               @unique(map: "uq_bookings_code") @db.VarChar(20)
  customer_id                                       Int
  store_id                                          Int
  service_id                                        Int
  in_store                                          Boolean              @default(true)
  pickup_address_id                                 Int
  delivery_address_id                               Int
  scheduled_pickup_start                            DateTime             @db.Timestamp(6)
  scheduled_pickup_end                              DateTime             @db.Timestamp(6)
  estimated_delivery_at                             DateTime?            @db.Timestamp(6)
  status                                            bookings_status_enum @default(pending_payment)
  estimated_weight_kg                               Decimal?             @db.Decimal(6, 2)
  actual_weight_kg                                  Decimal?             @db.Decimal(6, 2)
  estimated_price                                   Decimal              @db.Decimal(10, 2)
  final_price                                       Decimal?             @db.Decimal(10, 2)
  discount_amount                                   Decimal              @default(0) @db.Decimal(10, 2)
  promotion_id                                      Int?
  special_instructions                              String?              @db.VarChar(255)
  qr_token                                          String?              @unique(map: "uq_bookings_qr_token") @db.VarChar(255)
  cancelled_by                                      Int?
  cancellation_reason                               String?              @db.VarChar(255)
  created_at                                        DateTime             @default(now()) @db.Timestamp(6)
  updated_at                                        DateTime             @default(now()) @db.Timestamp(6)
  booking_items                                     booking_items[]
  users_bookings_cancelled_byTousers                users?               @relation("bookings_cancelled_byTousers", fields: [cancelled_by], references: [id], onUpdate: NoAction, map: "fk_bookings_cancelled_by")
  users_bookings_customer_idTousers                 users                @relation("bookings_customer_idTousers", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bookings_customer")
  addresses_bookings_delivery_address_idToaddresses addresses            @relation("bookings_delivery_address_idToaddresses", fields: [delivery_address_id], references: [id], onUpdate: NoAction, map: "fk_bookings_delivery_address")
  addresses_bookings_pickup_address_idToaddresses   addresses            @relation("bookings_pickup_address_idToaddresses", fields: [pickup_address_id], references: [id], onUpdate: NoAction, map: "fk_bookings_pickup_address")
  promotions                                        promotions?          @relation(fields: [promotion_id], references: [id], onUpdate: NoAction, map: "fk_bookings_promotion")
  services                                          services             @relation(fields: [service_id], references: [id], onUpdate: NoAction, map: "fk_bookings_service")
  laundry_stores                                    laundry_stores       @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bookings_store")
  complaints                                        complaints[]
  delivery_trips                                    delivery_trips[]
  machine_usage_logs                                machine_usage_logs[]
  notifications                                     notifications[]
  payments                                          payments[]
  reviews                                           reviews?

  @@index([customer_id], map: "idx_bookings_customer")
  @@index([promotion_id], map: "idx_bookings_promotion")
  @@index([status], map: "idx_bookings_status")
  @@index([store_id, scheduled_pickup_start, scheduled_pickup_end], map: "idx_bookings_store_slot")
}

model complaints {
  id                                  Int                    @id @default(autoincrement())
  booking_id                          Int
  booking_item_id                     Int?
  customer_id                         Int
  type                                complaints_type_enum
  description                         String
  evidence_image_url                  String?                @db.VarChar(255)
  status                              complaints_status_enum @default(open)
  resolution_note                     String?                @db.VarChar(255)
  compensation_amount                 Decimal?               @db.Decimal(10, 2)
  resolved_by                         Int?
  resolved_at                         DateTime?              @db.Timestamp(6)
  created_at                          DateTime               @default(now()) @db.Timestamp(6)
  updated_at                          DateTime               @default(now()) @db.Timestamp(6)
  bookings                            bookings               @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_complaints_booking")
  booking_items                       booking_items?         @relation(fields: [booking_item_id], references: [id], onUpdate: NoAction, map: "fk_complaints_booking_item")
  users_complaints_customer_idTousers users                  @relation("complaints_customer_idTousers", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_complaints_customer")
  users_complaints_resolved_byTousers users?                 @relation("complaints_resolved_byTousers", fields: [resolved_by], references: [id], onUpdate: NoAction, map: "fk_complaints_resolved_by")

  @@index([booking_id], map: "idx_complaints_booking")
  @@index([status], map: "idx_complaints_status")
}

model customer_profiles {
  user_id                         Int                                                    @id
  default_address_id              Int?
  preferred_store_id              Int?
  preferred_service_id            Int?
  detergent_preference            customer_profiles_detergent_preference_enum            @default(regular)
  water_temperature_preference    customer_profiles_water_temperature_preference_enum    @default(warm)
  fold_preference                 customer_profiles_fold_preference_enum                 @default(no_preference)
  notification_channel_preference customer_profiles_notification_channel_preference_enum @default(in_app)
  loyalty_points                  Int                                                    @default(0)
  membership_tier                 customer_profiles_membership_tier_enum                 @default(bronze)
  date_of_birth                   DateTime?                                              @db.Date
  gender                          customer_profiles_gender_enum?
  created_at                      DateTime                                               @default(now()) @db.Timestamp(6)
  updated_at                      DateTime                                               @default(now()) @db.Timestamp(6)
  addresses                       addresses?                                             @relation(fields: [default_address_id], references: [id], onUpdate: NoAction, map: "fk_customer_profiles_address")
  services                        services?                                              @relation(fields: [preferred_service_id], references: [id], onUpdate: NoAction, map: "fk_customer_profiles_service")
  laundry_stores                  laundry_stores?                                        @relation(fields: [preferred_store_id], references: [id], onUpdate: NoAction, map: "fk_customer_profiles_store")
  users                           users                                                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_profiles_user")
}

model delivery_trips {
  id              Int                           @id @default(autoincrement())
  booking_id      Int
  trip_type       delivery_trips_trip_type_enum
  shipper_id      Int?
  address_id      Int
  scheduled_time  DateTime                      @db.Timestamp(6)
  started_at      DateTime?                     @db.Timestamp(6)
  completed_at    DateTime?                     @db.Timestamp(6)
  status          delivery_trips_status_enum    @default(unassigned)
  proof_image_url String?                       @db.VarChar(255)
  note            String?                       @db.VarChar(255)
  created_at      DateTime                      @default(now()) @db.Timestamp(6)
  updated_at      DateTime                      @default(now()) @db.Timestamp(6)
  addresses       addresses                     @relation(fields: [address_id], references: [id], onUpdate: NoAction, map: "fk_delivery_trips_address")
  bookings        bookings                      @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_delivery_trips_booking")
  users           users?                        @relation(fields: [shipper_id], references: [id], onUpdate: NoAction, map: "fk_delivery_trips_shipper")

  @@unique([booking_id, trip_type], map: "uq_delivery_trip_booking_type")
  @@index([shipper_id, scheduled_time], map: "idx_delivery_trips_shipper")
  @@index([status], map: "idx_delivery_trips_status")
}

model email_verification_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token_hash String   @unique(map: "uq_email_verification_token_hash") @db.Char(64)
  expires_at DateTime @db.Timestamp(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_email_verification_tokens_user")

  @@index([user_id], map: "idx_email_verification_tokens_user")
}

model laundry_stores {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @db.VarChar(150)
  address                     String                      @db.VarChar(255)
  latitude                    Decimal?                    @db.Decimal(10, 7)
  longitude                   Decimal?                    @db.Decimal(10, 7)
  description                 String?
  phone                       String?                     @db.VarChar(20)
  image_url                   String?                     @db.VarChar(255)
  cancellation_hours_before   Int                         @default(2)
  cancellation_refund_percent Int                         @default(100) @db.SmallInt
  status                      laundry_stores_status_enum  @default(active)
  created_by                  Int?
  created_at                  DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                  DateTime                    @default(now()) @db.Timestamp(6)
  bookings                    bookings[]
  customer_profiles           customer_profiles[]
  users                       users?                      @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_laundry_stores_created_by")
  machines                    machines[]
  reviews                     reviews[]
  services                    services[]
  staff_assignments           staff_assignments[]
  store_schedule_exceptions   store_schedule_exceptions[]
  store_schedules             store_schedules[]
  waitlist                    waitlist[]

  @@index([status], map: "idx_laundry_stores_status")
}

model machine_usage_logs {
  id         Int       @id @default(autoincrement())
  machine_id Int
  booking_id Int
  started_at DateTime  @db.Timestamp(6)
  ended_at   DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  bookings   bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_machine_usage_booking")
  machines   machines  @relation(fields: [machine_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_machine_usage_machine")

  @@index([booking_id], map: "idx_machine_usage_booking")
  @@index([machine_id, started_at, ended_at], map: "idx_machine_usage_machine_time")
}

model machines {
  id                 Int                  @id @default(autoincrement())
  store_id           Int
  name               String               @db.VarChar(100)
  type               machines_type_enum
  capacity_kg        Decimal              @default(7.00) @db.Decimal(6, 2)
  status             machines_status_enum @default(idle)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  machine_usage_logs machine_usage_logs[]
  laundry_stores     laundry_stores       @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_machines_store")

  @@index([status], map: "idx_machines_status")
  @@index([store_id], map: "idx_machines_store")
}

model notifications {
  id                 Int                        @id @default(autoincrement())
  user_id            Int
  type               notifications_type_enum
  channel            notifications_channel_enum
  title              String                     @db.VarChar(150)
  message            String
  related_booking_id Int?
  is_read            Boolean                    @default(false)
  sent_at            DateTime?                  @db.Timestamp(6)
  created_at         DateTime                   @default(now()) @db.Timestamp(6)
  bookings           bookings?                  @relation(fields: [related_booking_id], references: [id], onUpdate: NoAction, map: "fk_notifications_booking")
  users              users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([related_booking_id], map: "idx_notifications_booking")
  @@index([user_id, is_read], map: "idx_notifications_user_read")
}

model password_reset_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token_hash String   @unique(map: "uq_password_reset_token_hash") @db.Char(64)
  expires_at DateTime @db.Timestamp(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_tokens_user")

  @@index([user_id], map: "idx_password_reset_tokens_user")
}

model payments {
  id                      Int                        @id @default(autoincrement())
  booking_id              Int
  payment_type            payments_payment_type_enum @default(full)
  amount                  Decimal                    @db.Decimal(10, 2)
  method                  payments_method_enum
  provider_transaction_id String?                    @db.VarChar(100)
  status                  payments_status_enum       @default(pending)
  paid_at                 DateTime?                  @db.Timestamp(6)
  refunded_at             DateTime?                  @db.Timestamp(6)
  raw_response            Json?
  created_at              DateTime                   @default(now()) @db.Timestamp(6)
  updated_at              DateTime                   @default(now()) @db.Timestamp(6)
  bookings                bookings                   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_booking")

  @@index([booking_id], map: "idx_payments_booking")
}

model promotions {
  id            Int                           @id @default(autoincrement())
  code          String                        @unique(map: "uq_promotions_code") @db.VarChar(30)
  description   String?                       @db.VarChar(255)
  discount_type promotions_discount_type_enum
  value         Decimal                       @db.Decimal(10, 2)
  valid_from    DateTime                      @db.Timestamp(6)
  valid_to      DateTime                      @db.Timestamp(6)
  usage_limit   Int?
  used_count    Int                           @default(0)
  status        promotions_status_enum        @default(active)
  created_by    Int?
  created_at    DateTime                      @default(now()) @db.Timestamp(6)
  updated_at    DateTime                      @default(now()) @db.Timestamp(6)
  bookings      bookings[]
  users         users?                        @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_promotions_created_by")
}

model refresh_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token_hash String   @db.VarChar(255)
  expires_at DateTime @db.Timestamp(6)
  revoked    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_tokens_user")

  @@index([user_id], map: "idx_refresh_tokens_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id             Int            @id @default(autoincrement())
  booking_id     Int            @unique(map: "uq_reviews_booking")
  customer_id    Int
  store_id       Int
  rating         Int            @db.SmallInt
  comment        String?
  created_at     DateTime       @default(now()) @db.Timestamp(6)
  bookings       bookings       @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reviews_booking")
  users          users          @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reviews_customer")
  laundry_stores laundry_stores @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reviews_store")

  @@index([store_id], map: "idx_reviews_store")
}

model services {
  id                         Int                        @id @default(autoincrement())
  store_id                   Int?
  name                       String                     @db.VarChar(100)
  description                String?
  pricing_unit               services_pricing_unit_enum @default(per_kg)
  unit_price                 Decimal                    @db.Decimal(10, 2)
  estimated_turnaround_hours Int                        @default(24)
  status                     services_status_enum       @default(active)
  created_at                 DateTime                   @default(now()) @db.Timestamp(6)
  updated_at                 DateTime                   @default(now()) @db.Timestamp(6)
  bookings                   bookings[]
  customer_profiles          customer_profiles[]
  laundry_stores             laundry_stores?            @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_services_store")

  @@index([status], map: "idx_services_status")
  @@index([store_id], map: "idx_services_store")
}

model staff_assignments {
  id             Int            @id @default(autoincrement())
  staff_id       Int
  store_id       Int
  assigned_at    DateTime       @default(now()) @db.Timestamp(6)
  users          users          @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_staff_assignments_staff")
  laundry_stores laundry_stores @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_staff_assignments_store")

  @@unique([staff_id, store_id], map: "uq_staff_store")
  @@index([store_id], map: "idx_staff_assignments_store")
}

model store_schedule_exceptions {
  id             Int            @id @default(autoincrement())
  store_id       Int
  exception_date DateTime       @db.Date
  is_closed      Boolean        @default(true)
  open_time      DateTime?      @db.Time(6)
  close_time     DateTime?      @db.Time(6)
  reason         String?        @db.VarChar(255)
  laundry_stores laundry_stores @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_store_schedule_exceptions_store")

  @@unique([store_id, exception_date], map: "uq_store_exception_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model store_schedules {
  id                    Int            @id @default(autoincrement())
  store_id              Int
  day_of_week           Int            @db.SmallInt
  open_time             DateTime       @db.Time(6)
  close_time            DateTime       @db.Time(6)
  slot_duration_minutes Int            @default(60)
  max_bookings_per_slot Int            @default(5)
  laundry_stores        laundry_stores @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_store_schedules_store")

  @@unique([store_id, day_of_week], map: "uq_store_day")
}

model users {
  id                                       Int                         @id @default(autoincrement())
  full_name                                String                      @db.VarChar(100)
  email                                    String                      @unique(map: "uq_users_email") @db.VarChar(150)
  password_hash                            String                      @db.VarChar(255)
  phone                                    String?                     @db.VarChar(20)
  role                                     users_role_enum             @default(customer)
  avatar_url                               String?                     @db.VarChar(255)
  status                                   users_status_enum           @default(active)
  email_verified_at                        DateTime?                   @db.Timestamp(6)
  created_at                               DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                               DateTime                    @default(now()) @db.Timestamp(6)
  addresses                                addresses[]
  audit_logs                               audit_logs[]
  bookings_bookings_cancelled_byTousers    bookings[]                  @relation("bookings_cancelled_byTousers")
  bookings_bookings_customer_idTousers     bookings[]                  @relation("bookings_customer_idTousers")
  complaints_complaints_customer_idTousers complaints[]                @relation("complaints_customer_idTousers")
  complaints_complaints_resolved_byTousers complaints[]                @relation("complaints_resolved_byTousers")
  customer_profiles                        customer_profiles?
  delivery_trips                           delivery_trips[]
  email_verification_tokens                email_verification_tokens[]
  laundry_stores                           laundry_stores[]
  notifications                            notifications[]
  password_reset_tokens                    password_reset_tokens[]
  promotions                               promotions[]
  refresh_tokens                           refresh_tokens[]
  reviews                                  reviews[]
  staff_assignments                        staff_assignments[]
  waitlist                                 waitlist[]

  @@index([role], map: "idx_users_role")
}

model waitlist {
  id                 Int                  @id @default(autoincrement())
  customer_id        Int
  store_id           Int
  desired_start_time DateTime             @db.Timestamp(6)
  desired_end_time   DateTime             @db.Timestamp(6)
  status             waitlist_status_enum @default(waiting)
  notified_at        DateTime?            @db.Timestamp(6)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  users              users                @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_waitlist_customer")
  laundry_stores     laundry_stores       @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_waitlist_store")

  @@index([customer_id], map: "idx_waitlist_customer")
  @@index([store_id, desired_start_time], map: "idx_waitlist_store_time")
}

enum bookings_status_enum {
  pending_payment
  confirmed
  picked_up
  processing
  ready_for_delivery
  delivering
  completed
  cancelled
  no_show
}

enum complaints_status_enum {
  open
  investigating
  resolved
  rejected
}

enum complaints_type_enum {
  lost_item
  damaged_item
  wrong_item
  late_delivery
  other
}

enum customer_profiles_detergent_preference_enum {
  regular
  fragrance_free
  sensitive_skin
}

enum customer_profiles_fold_preference_enum {
  fold
  hang
  no_preference
}

enum customer_profiles_gender_enum {
  male
  female
  other
}

enum customer_profiles_membership_tier_enum {
  bronze
  silver
  gold
}

enum customer_profiles_notification_channel_preference_enum {
  email
  push
  in_app
  sms
}

enum customer_profiles_water_temperature_preference_enum {
  cold
  warm
  hot
}

enum delivery_trips_status_enum {
  unassigned
  assigned
  in_progress
  completed
  failed
  cancelled
}

enum delivery_trips_trip_type_enum {
  pickup
  delivery
}

enum laundry_stores_status_enum {
  active
  inactive
}

enum machines_status_enum {
  idle
  running
  maintenance
