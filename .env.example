# APPLICATION CONFIGURATION
NODE_ENV=development    # production | development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# DATABASE CONFIGURATION
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DATABASE_URL=

# REDIS CONFIGURATION
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_SECRET=

# MAIL CONFIGURATION
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# PAYMENT CONFIGURATION (khong bat buoc khi dev; thieu key thi gateway tuong ung tra 503)
# Trang frontend hien ket qua thanh toan, :bookingId duoc thay bang id don
PAYMENT_RESULT_URL=http://localhost:5173/customer/bookings/:bookingId
# VNPay (sandbox). RETURN_URL tro ve backend: <host>/api/payments/vnpay/return
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
# MoMo (test). REDIRECT_URL: <host>/api/payments/momo/return, IPN_URL: <host>/api/payments/momo/ipn
# IPN_URL va URL IPN khai bao tren cong VNPay (<host>/api/payments/vnpay/ipn) phai public (vd ngrok)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

SALT_ROUNDS=10
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
PASSWORD_RESET_TOKEN_SECRET=
EMAIL_VERIFICATION_TOKEN_SECRET=

# Rate limit cho API auth. Dat false de tat tam khi dev (production luon bat)
RATE_LIMIT_ENABLED=true
